{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "always"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "eqeqeq",
        "explicit-function-return-type",
        "no-console",
        "no-throw-literal"
      ]
    }
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write index.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write index.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check index.ts",
    "deploy": "supabase functions deploy book-appointment --no-verify-jwt"
  },
  "imports": {
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@^2.7.1",
    "zod": "jsr:zod@^3.23.8",
    "std/": "https://deno.land/std@0.210.0/",
    "@std/assert": "jsr:@std/assert@1",
    "@std/async": "jsr:@std/async@1",
    "@std/datetime": "jsr:@std/datetime@1",
    "@std/http": "jsr:@std/http@1"
  },
  "nodeModulesDir": "auto"
}